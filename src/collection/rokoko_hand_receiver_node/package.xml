<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rokoko_hand_receiver</name>
  <version>0.1.0</version>
  <description>Strict Rokoko JSON v3 UDP receiver publishing per-side RawHandFrame messages.</description>
  <maintainer email="noreply@dexhit.local">Dexhit</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rokoko_omnihand_msgs</exec_depend>
  <exec_depend>python3-lz4</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
